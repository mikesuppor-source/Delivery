# Required — from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role — NEVER expose to browser. Used for admin operations only.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Signs courier app sessions (32+ random characters). If omitted, a key is derived
# from SUPABASE_SERVICE_ROLE_KEY. Changing it signs every courier out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DRIVER_SESSION_SECRET=

# Your Vercel deployment URL (or localhost for dev)
NEXT_PUBLIC_SITE_URL=https://delivery-five-roan.vercel.app

# Secret a scheduler sends as "Authorization: Bearer <value>" to the /api/cron/* jobs
# (weekly courier bonuses, warehouse hold checks). Without it those routes refuse every request.
# CRON_SECRET=

# Optional default workspace for public merchant signups (defaults to first workspace if omitted)
# MERCHANT_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# Shopify App Credentials (from Shopify Partners > Apps > Cedar Delivery)
SHOPIFY_CLIENT_ID=cf8028e469ae3e06ebefe5fec8fd96d3
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret_here
